{
  "name": "linkedin-automation-system",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "proxy": "http://localhost:5000",
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.8.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server:install": "npm --prefix server install",
    "server:start": "npm --prefix server start",
    "dev": "concurrently -k \"npm run server:start\" \"npm start\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gh-pages": "^6.0.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
